{
  "name": "seasharem1-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "SEA-SHARE Módulo 1: frontend de gestión de flota y embarcaciones",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{html,css,js}\"",
    "format:check": "prettier --check \"**/*.{html,css,js}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
